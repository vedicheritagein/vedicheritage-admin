# Base URL of the payments API.
#
# Leave EMPTY (the default) so the dashboard calls its own origin. In
# development the Vite proxy in vite.config.ts forwards /admin/* to the API, and
# in production the dashboard should be served behind the same hostname as the
# API - both cases are same-origin, which is why no CORS change is needed.
#
# Only set this if the dashboard really must live on a different origin, and
# remember that the API's CORS_ORIGIN would then have to name it.
VITE_API_BASE_URL=

# Where the dev proxy forwards to. Change if the API runs on another port.
# The dashboard's own dev server listens on http://localhost:5180.
VITE_API_TARGET=http://localhost:8080

# Production (the dashboard is hosted on Vercel at
# https://vedicheritage-admin.vercel.app, the API on Cloud Run), so the two are
# NOT same-origin and this must be set. The API's CORS_ORIGIN has to name the
# dashboard's origin in return.
# VITE_API_BASE_URL=https://vedicheritage-592313850466.us-central1.run.app
